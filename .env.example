DATABASE_URL="file:./dev.db"

# ==========================================
# SUPABASE CONFIGURATION (База данных игроков)
# ==========================================
# URL проекта Supabase (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Публичный анонимный ключ Supabase (Settings -> API -> Project API keys -> anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Сервисный ключ Supabase (опционально, для бэкенда и обхода RLS: service_role)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ==========================================
# ЮKASSA CONFIGURATION (Платежный шлюз)
# ==========================================
# Идентификатор магазина (shopId из личного кабинета ЮKassa)
YOOKASSA_SHOP_ID=""

# Секретный ключ API (из настроек интеграции ЮKassa)
YOOKASSA_SECRET_KEY=""