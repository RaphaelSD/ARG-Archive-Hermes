# ==========================================
# БАЗА ДАННЫХ (PostgreSQL на сервере в РФ — требование 152-ФЗ)
# ==========================================
DATABASE_URL="postgresql://user:password@host:5432/arg_archive"

# Адрес сайта (для возврата после оплаты), без слеша в конце
APP_URL="https://your-domain.ru"

# ==========================================
# ВХОД ПО КОДУ ИЗ ПИСЬМА
# ==========================================
# Длинная случайная строка, например: openssl rand -hex 32
AUTH_CODE_SECRET=""

# SMTP российского сервиса рассылок (Unisender Go, Яндекс 360, Mail.ru для бизнеса и т.п.)
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Архив города Н. <no-reply@your-domain.ru>"

# Только для теста: если SMTP не настроен, код показывается прямо в окне входа.
# На боевом сайте НЕ включать.
AUTH_DEV_SHOW_CODE="false"

# ==========================================
# ЮKASSA (платежи)
# ==========================================
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Только для теста: встроенная имитация оплаты без ЮKassa. На боевом сайте НЕ включать.
PAYMENT_MOCK_ENABLED="false"
