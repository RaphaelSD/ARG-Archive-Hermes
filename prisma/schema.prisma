generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  name         String?
  passwordHash String
  role         String         @default("player")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     Session[]
  caseAccess   CaseAccess[]
  gameProgress GameProgress[]
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Season {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cases       Case[]
}

model Case {
  id           Int             @id @default(autoincrement())
  slug         String          @unique
  seasonId     Int
  number       String?
  title        String
  description  String?
  coverPath    String?
  status       String          @default("locked")
  order        Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  season       Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  caseAccess   CaseAccess[]
  evidence     EvidenceItem[]
  documents    Document[]
  notes        Note[]
  calls        Call[]
  mapPoints    MapPoint[]
  gameProgress GameProgress[]
  timeline     TimelineEntry[]
  callLog      CallLog?
  locations    CaseLocation[]
}

model CaseAccess {
  id          Int       @id @default(autoincrement())
  userId      Int
  caseId      Int
  status      String    @default("locked")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
}

model EvidenceItem {
  id        Int      @id @default(autoincrement())
  caseId    Int
  title     String
  kind      String   @default("artifact")
  summary   String?
  content   String?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Document {
  id        Int      @id @default(autoincrement())
  caseId    Int
  sourceId  String?
  title     String
  kind      String   @default("report")
  meta      String?
  content   String?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, sourceId])
}

model Note {
  id        Int      @id @default(autoincrement())
  caseId    Int
  sourceId  String?
  title     String?
  author    String
  body      String
  locked    Boolean  @default(false)
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, sourceId])
}

model Call {
  id         Int      @id @default(autoincrement())
  caseId     Int
  date       String?
  time       String?
  number     String?
  duration   String?
  type       String?
  flagged    Boolean  @default(false)
  sourceId   String?
  callLogId  Int?
  timestamp  String
  caller     String
  summary    String
  transcript String?
  createdAt  DateTime @default(now())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  callLog    CallLog? @relation(fields: [callLogId], references: [id], onDelete: Cascade)

  @@unique([caseId, sourceId])
  @@index([caseId])
}

model MapPoint {
  id          Int      @id @default(autoincrement())
  caseId      Int
  label       String
  x           Int
  y           Int
  description String?
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model GameProgress {
  id          Int       @id @default(autoincrement())
  userId      Int
  caseId      Int
  progress    Int       @default(0)
  openedAt    DateTime?
  lastSeenAt  DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
}

model TimelineEntry {
  id        Int      @id @default(autoincrement())
  caseId    Int
  time      String
  text      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, order])
}

model CallLog {
  id        Int      @id @default(autoincrement())
  caseId    Int      @unique
  subject   String
  pin       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case  Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  calls Call[]
}

model Location {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  x           Int
  y           Int
  current     Boolean  @default(false)
  explored    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  caseLinks CaseLocation[]
}

model CaseLocation {
  caseId     Int
  locationId Int
  order      Int @default(0)

  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([caseId, locationId])
  @@index([locationId])
}
